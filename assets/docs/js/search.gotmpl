{{- /*
  Search popover (the popover itself is in layouts/partials/docs/top-header.html).
  JavaScript in a Go text template: resources.ExecuteAsTemplate in
  layouts/partials/docs/footer/flexsearch.html renders it once into a script file,
  so the Content Security Policy needs no inline script. Strings from Hugo go
  through jsonify, which makes them JavaScript string literals.
*/ -}}
    var suggestions = document.getElementById('suggestions');
    var search = document.getElementById('flexsearch');

    // The search field is in a form for its role; Enter must not submit it.
    search?.form?.addEventListener('submit', (event) => event.preventDefault());

    const flexsearchContainer = document.getElementById('FlexSearchCollapse');

    const hideFlexsearchBtn = document.getElementById('hideFlexsearch');

    const configObject = { toggle: false }
    const flexsearchContainerCollapse = new Collapse(flexsearchContainer, configObject) // initialized with no keyboard

    if (search !== null) {
        document.addEventListener('keydown', inputFocus);
        flexsearchContainer.addEventListener('shown.bs.collapse', function () {
            search.focus();
        });
        // hide search collapse containder by clicking outside (except top header)
        var topHeader = document.getElementById("top-header");
        document.addEventListener('click', function(elem) {
            if (!flexsearchContainer.contains(elem.target) && !topHeader.contains(elem.target))
                flexsearchContainerCollapse.hide();
        });
    }

    hideFlexsearchBtn.addEventListener('click', () =>{
        flexsearchContainerCollapse.hide()
    })

    function inputFocus(e) {
        if (e.ctrlKey && e.key === '/') {
            e.preventDefault();
            flexsearchContainerCollapse.toggle();
        }
        if (e.key === 'Escape' && flexsearchContainer.classList.contains('show')) {
            flexsearchContainerCollapse.hide();
            document.getElementById('flexsearch-button')?.focus();
        }
    };

    // Put the panel under the search field (on narrow screens it spans the
    // width of the screen).
    const searchButton = document.getElementById('flexsearch-button');
    const searchPanel = flexsearchContainer.querySelector('.search-popover-panel');
    flexsearchContainer.addEventListener('show.bs.collapse', function () {
        if (!searchButton || !searchPanel || window.innerWidth < 576) {
            searchPanel?.style.removeProperty('margin-left');
            return;
        }
        const field = searchButton.getBoundingClientRect();
        // The popover is still hidden here, so measure the toolbar.
        const header = document.getElementById('top-header').getBoundingClientRect();
        const width = Math.min(640, header.width - 16);
        const left = Math.min(Math.max(field.left - header.left - 8, 0), header.width - 16 - width);
        searchPanel.style.marginLeft = `${left}px`;
    });

    flexsearchContainer.addEventListener('hidden.bs.collapse', function () {
        search.setAttribute('aria-expanded', 'false');
    });

    /*
    Source:
    - https://dev.to/shubhamprakash/trap-focus-using-javascript-6a3
    */

    document.addEventListener('keydown',suggestionFocus);

    function suggestionFocus(e) {
    if (!flexsearchContainer.classList.contains('show')) return;
    if (suggestions.classList.contains('d-none')) return;

    const options = [...suggestions.querySelectorAll('[role="option"]')];
    if (options.length === 0) return;

    const index = options.indexOf(document.activeElement);

    if (e.key === "ArrowDown") {
        e.preventDefault();
        const nextIndex = index + 1 < options.length ? index + 1 : index;
        options[nextIndex].focus();
    }
    else if (e.key === "ArrowUp" && index !== -1) {
        e.preventDefault();
        if (index === 0) {
            search.focus();
        } else {
            options[index - 1].focus();
        }
    }
    }

    // The focused result is the selected option.
    suggestions.addEventListener('focusin', (e) => {
        suggestions.querySelectorAll('[role="option"]').forEach((option) => {
            option.setAttribute('aria-selected', String(option === e.target));
        });
    });

    /*
    Source:
    - https://github.com/nextapps-de/flexsearch#index-documents-field-search
    - https://raw.githack.com/nextapps-de/flexsearch/master/demo/autocomplete.html
    */

    (function(){

    // The search index is built the first time a visitor searches (or opens
    // the search box), not on page load: FlexSearch and /search-index.json
    // are loaded then. That keeps page loads fast.
    {{- $flexSearch := resources.Get (printf "/%s/%s" ($.Scratch.Get "pathName") "js/flexsearch.bundle.js") }}
    {{- if not hugo.IsServer }}
        {{- $flexSearch = $flexSearch | minify | fingerprint "sha384" }}
    {{- end }}
    const flexSearchSrc = {{ $flexSearch.RelPermalink | jsonify }};
    const flexSearchIntegrity = {{ if not hugo.IsServer }}{{ $flexSearch.Data.Integrity | jsonify }}{{ else }}""{{ end }};
    {{- /* The search index: one JSON file for the whole site, made once (this
           partial is cached) and fingerprinted, so browsers can cache it. */}}
    {{- $list := slice -}}
    {{- $pathName := $.Scratch.Get "pathName" -}}
    {{- if and (isset .Site.Params.flexsearch "searchsectionsindex") (not (eq (len .Site.Params.flexsearch.searchSectionsIndex) 0)) -}}
      {{- if eq .Site.Params.flexsearch.searchSectionsIndex "ALL" -}}
        {{- $list = .Site.Pages -}}
      {{- else -}}
        {{- $list = where .Site.Pages "Type" "in" .Site.Params.flexsearch.searchSectionsIndex -}}
        {{- if in .Site.Params.flexsearch.searchSectionsIndex "HomePage" -}}
          {{- $list = $list | append .Site.Home -}}
        {{- end -}}
      {{- end -}}
    {{- else -}}
      {{- $list = where .Site.Pages "Section" $pathName -}}
    {{- end -}}
    {{- $docs := slice -}}
    {{- range $index, $page := $list -}}
      {{- $description := .Description | default (.Summary | htmlUnescape | plainify) -}}
      {{- $docs = $docs | append (dict
        "id" $index
        "href" .RelPermalink
        "title" .Title
        "description" $description
        "content" (.Content | htmlUnescape | plainify)
      ) -}}
    {{- end -}}
    {{- $searchIndex := resources.FromString "docs/search-index.json" ($docs | jsonify) | minify | fingerprint "sha256" }}
    const searchIndexURL = {{ $searchIndex.RelPermalink | jsonify }};

    let index = null;
    let indexPromise = null;

    function loadFlexSearch() {
        if (window.FlexSearch) return Promise.resolve();
        return new Promise((resolve, reject) => {
            const script = document.createElement('script');
            script.src = flexSearchSrc;
            if (flexSearchIntegrity) {
                script.integrity = flexSearchIntegrity;
                script.crossOrigin = 'anonymous';
            }
            script.onload = resolve;
            script.onerror = reject;
            document.head.appendChild(script);
        });
    }

    function ensureIndex() {
        if (indexPromise) return indexPromise;
        indexPromise = Promise.all([
            loadFlexSearch(),
            fetch(searchIndexURL).then((response) => response.json())
        ]).then(([, docs]) => {
            const newIndex = new FlexSearch.Document({
                // FlexSearch 0.8 removes repeated letters by default (so "ssh" also
                // finds "sh"). Keep the default Latin normalisation without that.
                encoder: new FlexSearch.Encoder(FlexSearch.Charset.LatinDefault, {dedupe: false}),
                tokenize: {{ .Site.Params.flexsearch.tokenize | default "forward" | jsonify }},
                minlength: {{ .Site.Params.flexsearch.minQueryChar | default 0}},
                cache: {{ .Site.Params.flexsearch.cache | default 100 }},
                document: {
                id: 'id',
                store: [
                    "href", "title", "description"
                ],
                index: ["title", "description", "content"]
                }
            });
            for (const doc of docs) newIndex.add(doc);
            index = newIndex;
        }).catch((error) => {
            indexPromise = null;
            throw error;
        });
        return indexPromise;
    }

    // Start loading as soon as the visitor shows interest in searching.
    search.addEventListener('focus', () => { ensureIndex().catch(() => {}); }, {once: true});
    document.getElementById('flexsearch-button')?.addEventListener('click', () => { ensureIndex().catch(() => {}); }, {once: true});
    flexsearchContainer.addEventListener('show.bs.collapse', () => { ensureIndex().catch(() => {}); }, {once: true});

    // Flatten the per-field results of index.search() into one Map keyed by
    // href, which also removes duplicates. The Map keeps the ranking order.
    function flatten_results(results) {
        const flat = new Map();
        for (const result of results.flatMap(r => r.result)) {
            if (!flat.has(result.doc.href)) flat.set(result.doc.href, result.doc);
        }
        return flat;
    }

    // FlexSearch 0.8 ranks documents that match only some of the words in a
    // query. Keep the ranking, but only return documents that match all words.
    const searchLimit = 100000;

    function search_documents(query) {
        const ranked = flatten_results(index.search(query, {limit: searchLimit, enrich: true}));
        const terms = query.split(/\s+/).filter(Boolean);
        if (terms.length > 1) {
            for (const term of terms) {
                const matches = flatten_results(index.search(term, {limit: searchLimit, enrich: true}));
                for (const href of [...ranked.keys()]) {
                    if (!matches.has(href)) ranked.delete(href);
                }
            }
        }
        return ranked;
    }

    search.addEventListener('input', show_results, true);

    function show_results(){
        if (!index) {
            // Show the results when the index is ready.
            const input = this;
            ensureIndex().then(() => show_results.call(input)).catch(() => {
                suggestions.replaceChildren();
                suggestions.classList.remove('d-none');
                const errorMessage = document.createElement('div');
                errorMessage.textContent = {{ i18n "search_error" | default "The search index could not be loaded." | jsonify }};
                errorMessage.classList.add("suggestion__no-results");
                errorMessage.setAttribute('role', 'option');
                errorMessage.setAttribute('aria-disabled', 'true');
                suggestions.appendChild(errorMessage);
            });
            return;
        }
        const maxResult = {{ .Site.Params.flexsearch.maxResult | default 5}};
        const minlength = {{ .Site.Params.flexsearch.minQueryChar | default 0}};
        // The query is only searched and shown as text (textContent), never
        // parsed as HTML, so it needs no escaping.
        const searchQuery = this.value.trim();
        const flatResults = search_documents(searchQuery);

        suggestions.replaceChildren();
        suggestions.classList.toggle('d-none', searchQuery.length === 0);
        search.setAttribute('aria-expanded', String(searchQuery.length > 0));
        if (searchQuery.length === 0) return;

        // inform user of search query minimum character requirement
        if (searchQuery.length < minlength) {
            const minCharMessage = document.createElement('div')
            const minCount = document.createElement('strong');
            minCount.textContent = String(minlength);
            minCharMessage.append('Please type at least ', minCount, ' characters');
            minCharMessage.classList.add("suggestion__no-results");
            minCharMessage.setAttribute('role', 'option');
            minCharMessage.setAttribute('aria-disabled', 'true');
            suggestions.appendChild(minCharMessage);
            return;
        } else {
            // inform user that no results were found
            if (flatResults.size === 0 && searchQuery) {
                const noResultsMessage = document.createElement('div')
                const queryText = document.createElement('strong');
                queryText.textContent = searchQuery;
                noResultsMessage.append({{ i18n "search_no_results" | default "No results for" | jsonify }} + ' "', queryText, '"');
                noResultsMessage.classList.add("suggestion__no-results");
                noResultsMessage.setAttribute('role', 'option');
                noResultsMessage.setAttribute('aria-disabled', 'true');
                suggestions.appendChild(noResultsMessage);
                return;
            }
        }

        // construct a list of suggestions
        for(const [href, doc] of flatResults) {
            const entry = document.createElement('div');
            suggestions.appendChild(entry);

            const a = document.createElement('a');
            a.href = href;
            a.setAttribute('role', 'option');
            a.setAttribute('aria-selected', 'false');
            entry.setAttribute('role', 'presentation');
            entry.appendChild(a);

            const title = document.createElement('span');
            title.textContent = doc.title;
            title.classList.add("suggestion__title");
            a.appendChild(title);

            const description = document.createElement('span');
            description.textContent = doc.description;
            description.classList.add("suggestion__description");
            a.appendChild(description);

            suggestions.appendChild(entry);

            if(suggestions.childElementCount == maxResult) break;
        }
    }
    }());
