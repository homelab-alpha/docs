          "patches": [
            {
              "why": "Replace every '*', not only the first (CodeQL js/incomplete-sanitization).",
              "find": "[context.envName.replace(\"*\", \"\")]",
              "replace": "[context.envName.replace(/\\*/g, \"\")]"
            },
            {
              "why": "Replace every backslash, not only the first (CodeQL js/incomplete-sanitization).",
              "find": "new TextNode(group.leftDelim.replace(\"\\\\\", \"\"))",
              "replace": "new TextNode(group.leftDelim.replace(/\\\\/g, \"\"))"
            },
            {
              "why": "Replace every backslash, not only the first (CodeQL js/incomplete-sanitization).",
              "find": "new TextNode(group.rightDelim.replace(\"\\\\\", \"\"))",
              "replace": "new TextNode(group.rightDelim.replace(/\\\\/g, \"\"))"
            }
          ]
