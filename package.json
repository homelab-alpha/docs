{
  "name": "docs",
  "version": "0.1.0",
  "private": true,
  "description": "Source repository for the Homelab-Alpha documentation site, built with Hugo.",
  "license": "CC-BY-NC-SA-4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homelab-alpha/docs.git"
  },
  "scripts": {
    "lint": "bash .github/scripts/lint.sh",
    "lint:fix": "bash .github/scripts/lint.sh --fix",
    "test": "npm run test:csp && npm run test:links && npm run test:a11y && npm run test:lighthouse",
    "test:links": "node tests/links.mjs",
    "test:a11y": "node tests/a11y.mjs",
    "test:screenshots": "node tests/screenshots.mjs",
    "test:lighthouse": "node tests/lighthouse.mjs",
    "test:csp": "python3 .github/scripts/check_csp.py",
    "vendor:update": "node .github/scripts/update_vendored_assets.mjs",
    "vendor:check": "python3 .github/scripts/check_vendored_assets.py"
  },
  "devDependencies": {
    "axe-core": "4.14.1",
    "lighthouse": "13.6.0",
    "playwright-core": "1.65.1",
    "prettier": "3.10.1",
    "textlint": "16.1.3",
    "textlint-filter-rule-allowlist": "4.0.0",
    "textlint-filter-rule-comments": "1.3.0",
    "textlint-rule-terminology": "5.2.16"
  },
  "overrides": {
    "glob": "14.0.6",
    "minimatch": "11.0.9"
  },
  "engines": {
    "node": "^24.22.3"
  }
}
